[Unit]
Description=ROME Dictator Daemon
After=network.target

[Service]
ExecStart=/usr/bin/python3 -m dictator.daemon --port 8741
WorkingDirectory=/home/paul-kane/projects/rome-core
Environment=PYTHONPATH=/home/paul-kane/projects/rome-core
Environment=ROME_DAEMON=1
Restart=always
RestartSec=5
User=paul-kane

[Install]
WantedBy=multi-user.target
