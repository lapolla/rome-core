{
  "workers": [
    {
      "capability": "GEMINI",
      "invocation": "native_agent_cli",
      "probe": "test -f \"$GEMINI_CLI\"",
      "cli_command": "node $GEMINI_CLI --sandbox false --include-directories $ROME_ROOT --yolo --model {MODEL}",
      "output_format": "text",
      "models": [
        "gemini-2.5-pro",
        "gemini-2.0-flash",
        "gemini-1.5-pro"
      ],
      "model": "gemini-2.5-pro"
    },
    {
      "capability": "MISTRAL",
      "invocation": "native_agent_cli",
      "probe": "test -d /home/paul-kane/projects/mistral-cli && command -v uv",
      "cli_command": "uv run --directory /home/paul-kane/projects/mistral-cli python3 -m vibe.cli.entrypoint --output text --agent auto-approve --max-turns 10 -p {PROMPT}",
      "output_format": "text"
    },
    {
      "capability": "CLAUDE",
      "invocation": "native_agent_cli",
      "probe": "command -v claude",
      "cli_command": "claude --dangerously-skip-permissions --output-format json -p",
      "output_format": "json"
    },
    {
      "capability": "GEMMA",
      "invocation": "native_agent_ollama",
      "probe": "curl -sf --max-time 1 http://localhost:11434/",
      "model": "gemma4:e4b",
      "ollama_url": "http://localhost:11434"
    },
    {
      "capability": "HAIKU",
      "invocation": "native_agent_cli",
      "probe": "command -v claude",
      "cli_command": "claude --dangerously-skip-permissions --output-format json -p",
      "output_format": "json"
    }
  ]
}