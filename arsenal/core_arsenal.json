{
  "capabilities": {
    "GEMINI": {
      "exec": "{ROME_ROOT}/legions/legion_wrapper.py",
      "args": [
        "{GEMINI_CLI}",
        "--sandbox",
        "false",
        "--include-directories",
        "{ROME_ROOT}",
        "--yolo",
        "--output-format",
        "json",
        "-m",
        "gemini-3.1-pro-preview",
        "--ws-url",
        "ws://127.0.0.1:8741/ws",
        "--ws-token",
        "ROME_V4_SECURE_TOKEN",
        "-p"
      ],
      "timeout": 300,
      "min_version": "2.0",
      "_note": "Gemini CLI \u2014 -p must be last"
    },
    "CLAUDE": {
      "exec": "{ROME_ROOT}/legions/legion_wrapper.py",
      "args": [
        "claude",
        "--dangerously-skip-permissions",
        "--output-format",
        "json",
        "--model",
        "claude-opus-4-6",
        "--ws-url",
        "ws://127.0.0.1:8741/ws",
        "--ws-token",
        "ROME_V4_SECURE_TOKEN",
        "-p"
      ],
      "timeout": 300,
      "min_version": "1.0",
      "_note": "Anthropic Claude Opus 4.6 \u2014 -p must be last"
    },
    "CODEX": {
      "exec": "{ROME_ROOT}/legions/legion_wrapper.py",
      "args": [
        "codex",
        "exec",
        "--dangerously-bypass-approvals-and-sandbox",
        "--skip-git-repo-check",
        "-m",
        "o3"
      ],
      "timeout": 300,
      "min_version": "0.1",
      "_note": "OpenAI Codex CLI \u2014 requires OPENAI_API_KEY, not ChatGPT account. Currently disabled."
    },
    "SAFE_SHELL": {
      "exec": "python3",
      "args": [
        "{ROME_ROOT}/legions/shell_executor.py"
      ],
      "timeout": 600,
      "_note": "Dedicated bash executor \u2014 no LLM wrapper, no JSON parsing"
    },
    "CENTURION": {
      "exec": "python3",
      "args": [
        "{ROME_ROOT}/legions/centurion.py"
      ],
      "timeout": 600,
      "_note": "Parallel campaign orchestrator"
    },
    "BROWSER": {
      "exec": "{ROME_ROOT}/legions/browser_worker.py",
      "args": [],
      "timeout": 300,
      "_note": "Native WS browser worker"
    },
    "MISTRAL": {
      "exec": "{ROME_ROOT}/legions/legion_wrapper.py",
      "args": [
        "python3",
        "-m",
        "vibe.cli.entrypoint",
        "env:PYTHONPATH=/home/paul-kane/projects/mistral-cli",
        "--agent",
        "auto-approve",
        "--output",
        "streaming",
        "--ws-url",
        "ws://127.0.0.1:8741/ws",
        "--ws-token",
        "ROME_V4_SECURE_TOKEN",
        "-p"
      ],
      "timeout": 300,
      "min_version": "2.0",
      "_note": "Mistral Vibe CLI \u2014 -p must be last, requires PYTHONPATH=/home/paul-kane/projects/mistral-cli"
    }
  },
  "protocol_version": "1.0"
}