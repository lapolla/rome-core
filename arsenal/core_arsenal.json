{
  "capabilities": {
    "GEMINI": {
      "type": "llm",
      "args": [
        "{GEMINI_CLI}",
        "--sandbox",
        "false",
        "--include-directories",
        "{ROME_ROOT}",
        "--yolo",
        "--output-format",
        "json",
        "-m",
        "{MODEL}",
        "-p"
      ],
      "timeout": 300,
      "min_version": "2.0",
      "_note": "Gemini CLI — -p must be last",
      "model": "gemini-3-flash-preview",
      "model_fallback_chain": [
        "gemini-3.1-pro-preview",
        "gemini-3.1-flash-lite-preview"
      ]
    },
    "CLAUDE": {
      "type": "llm",
      "args": [
        "claude",
        "--dangerously-skip-permissions",
        "--output-format",
        "json",
        "--model",
        "claude-opus-4-6",
        "-p"
      ],
      "timeout": 300,
      "min_version": "1.0",
      "_note": "Anthropic Claude Opus 4.6 — -p must be last"
    },
    "GEMMA": {
      "type": "llm",
      "args": [
        "env:ANTHROPIC_AUTH_TOKEN=ollama",
        "env:ANTHROPIC_BASE_URL=http://localhost:11434",
        "claude",
        "--dangerously-skip-permissions",
        "--output-format",
        "json",
        "--model",
        "gemma4:e4b",
        "-p"
      ],
      "timeout": 300,
      "min_version": "1.0",
      "_note": "Gemma 4 via Ollama/Claude-CLI bridge"
    },
    "SAFE_SHELL": {
      "type": "shell",
      "timeout": 600,
      "_note": "Dedicated bash executor — runs in-process via src/shell_executor.ts"
    },
    "TEST": {
      "type": "shell",
      "timeout": 300,
      "_note": "Automated test runner"
    },
    "HAIKU": {
      "type": "llm",
      "args": [
        "claude",
        "--dangerously-skip-permissions",
        "--output-format",
        "json",
        "--model",
        "claude-haiku-4-5-20251001",
        "-p"
      ],
      "timeout": 120,
      "min_version": "1.0",
      "_note": "Claude Haiku 4.5 — fast cheap worker for file edits and simple tasks"
    },
    "MISTRAL": {
      "type": "llm",
      "args": [
        "uv",
        "run",
        "--directory",
        "/home/paul-kane/projects/mistral-cli",
        "python3",
        "-m",
        "vibe.cli.entrypoint",
        "--output",
        "text",
        "--agent",
        "auto-approve",
        "--max-turns",
        "10",
        "-p"
      ],
      "timeout": 300,
      "min_version": "2.0",
      "_note": "Mistral Vibe CLI via uv — -p must be last"
    }
  },
  "protocol_version": "1.1"
}
