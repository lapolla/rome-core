{
  "capabilities": {
    "GEMINI": {
      "type": "llm",
      "args": [
        "{GEMINI_CLI}",
        "--sandbox",
        "false",
        "--include-directories",
        "{ROME_ROOT}",
        "--yolo",
        "--output-format",
        "json",
        "-m",
        "{MODEL}",
        "-p"
      ],
      "timeout": 300,
      "min_version": "2.0",
      "_note": "Gemini CLI \u2014 -p must be last",
      "peer_port": 8742,
      "peer_host": "127.0.0.1",
      "model": "gemini-3-flash-preview",
      "model_fallback_chain": [
        "gemini-3.1-pro-preview",
        "gemini-3.1-flash-lite-preview"
      ]
    },
    "CLAUDE": {
      "type": "llm",
      "args": [
        "claude",
        "--dangerously-skip-permissions",
        "--output-format",
        "json",
        "--model",
        "claude-opus-4-6",
        "-p"
      ],
      "timeout": 300,
      "min_version": "1.0",
      "_note": "Anthropic Claude Opus 4.6 \u2014 -p must be last",
      "peer_port": 8743,
      "peer_host": "127.0.0.1"
    },
    "GEMMA": {
      "type": "llm",
      "args": [
        "env:ANTHROPIC_AUTH_TOKEN=ollama",
        "env:ANTHROPIC_BASE_URL=http://localhost:11434",
        "claude",
        "--dangerously-skip-permissions",
        "--output-format",
        "json",
        "--model",
        "gemma4:e4b",
        "-p"
      ],
      "timeout": 300,
      "min_version": "1.0",
      "_note": "Gemma 4 via Ollama/Claude-CLI bridge",
      "peer_port": 8750,
      "peer_host": "127.0.0.1"
    },
    "CODEX": {
      "type": "llm",
      "args": [
        "codex",
        "exec",
        "--dangerously-bypass-approvals-and-sandbox",
        "--skip-git-repo-check",
        "-m",
        "o3"
      ],
      "timeout": 300,
      "min_version": "0.1",
      "_note": "OpenAI Codex CLI \u2014 requires OPENAI_API_KEY, not ChatGPT account. Currently disabled.",
      "peer_port": 8744,
      "peer_host": "127.0.0.1"
    },
    "SAFE_SHELL": {
      "type": "shell",
      "timeout": 600,
      "_note": "Dedicated bash executor \u2014 runs in-process via src/shell_executor.ts",
      "peer_port": 8745,
      "peer_host": "127.0.0.1"
    },
    "TEST": {
      "type": "shell",
      "timeout": 300,
      "_note": "Automated test runner",
      "peer_port": 8751,
      "peer_host": "127.0.0.1"
    },
    "HAIKU": {
      "type": "llm",
      "args": [
        "claude",
        "--dangerously-skip-permissions",
        "--output-format",
        "json",
        "--model",
        "claude-haiku-4-5-20251001",
        "-p"
      ],
      "timeout": 120,
      "min_version": "1.0",
      "_note": "Claude Haiku 4.5 \u2014 fast cheap worker for file edits and simple tasks",
      "peer_port": 8749,
      "peer_host": "127.0.0.1"
    },
    "MISTRAL": {
      "type": "llm",
      "args": [
        "uv",
        "run",
        "--directory",
        "/home/paul-kane/projects/mistral-cli",
        "python3",
        "-m",
        "vibe.cli.entrypoint",
        "--output",
        "text",
        "--agent",
        "auto-approve",
        "--max-turns",
        "10",
        "-p"
      ],
      "timeout": 300,
      "min_version": "2.0",
      "_note": "Mistral Vibe CLI via uv \u2014 -p must be last",
      "peer_port": 8748,
      "peer_host": "127.0.0.1"
    },
    "GEMINI_FLASH": {
      "type": "llm",
      "args": [
        "{GEMINI_CLI}",
        "--sandbox",
        "false",
        "--include-directories",
        "{ROME_ROOT}",
        "--yolo",
        "--output-format",
        "json",
        "-m",
        "{MODEL}",
        "-p"
      ],
      "timeout": 300,
      "min_version": "2.0",
      "_note": "Gemini Flash \u2014 fallback when Pro is rate-limited",
      "peer_port": 8752,
      "peer_host": "127.0.0.1",
      "model": "gemini-3-flash-preview"
    }
  },
  "protocol_version": "1.1"
}