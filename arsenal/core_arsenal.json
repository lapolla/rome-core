{
  "capabilities": {
    "GEMINI": {
      "exec": "{ROME_ROOT}/legions/legion_wrapper.py",
      "args": [
        "{GEMINI_CLI}",
        "--sandbox",
        "false",
        "--include-directories",
        "{ROME_ROOT}",
        "--yolo",
        "--output-format",
        "json",
        "-m",
        "gemini-3.1-pro-preview",
        "--allowed-mcp-server-names",
        "rome-results",
        "-p"
      ],
      "timeout": 300,
      "min_version": "2.0",
      "_note": "Gemini CLI — -p must be last"
    },
    "CLAUDE": {
      "exec": "{ROME_ROOT}/legions/legion_wrapper.py",
      "args": [
        "claude",
        "--dangerously-skip-permissions",
        "--output-format",
        "json",
        "--allowed-mcp-server-names",
        "rome-results",
        "-p"
      ],
      "timeout": 300,
      "min_version": "1.0",
      "_note": "Anthropic Claude Code CLI — -p must be last"
    },
    "OPENCODE": {
      "exec": "{ROME_ROOT}/legions/legion_wrapper.py",
      "args": [
        "/home/paul-kane/.nvm/versions/node/v20.20.0/bin/opencode",
        "run"
      ],
      "timeout": 120,
      "min_version": "0.1",
      "_note": "Opencode CLI — prompt passed as positional arg by legion_wrapper"
    },
    "CODEX": {
      "exec": "{ROME_ROOT}/legions/legion_wrapper.py",
      "args": [
        "codex",
        "exec",
        "--dangerously-bypass-approvals-and-sandbox",
        "--skip-git-repo-check",
        "-m",
        "o3"
      ],
      "timeout": 300,
      "min_version": "0.1",
      "_note": "OpenAI Codex CLI — requires OPENAI_API_KEY, not ChatGPT account. Currently disabled."
    },
    "MCP_TOOL_CLIENT": {
      "exec": "python3",
      "args": [
        "{ROME_ROOT}/dictator/mcp_client_tool.py"
      ],
      "timeout": 120,
      "min_version": "0.1",
      "_note": "Internal MCP tool client"
    },
    "SAFE_SHELL": {
      "exec": "python3",
      "args": [
        "{ROME_ROOT}/legions/shell_executor.py"
      ],
      "timeout": 600,
      "_note": "Dedicated bash executor — no LLM wrapper, no JSON parsing"
    },
    "NATIVE_SHELL": {
      "exec": "internal",
      "args": [],
      "timeout": 600,
      "_note": "Daemon-native shell execution (v4 WS DSA)"
    }
  },
  "protocol_version": "1.0"
}
